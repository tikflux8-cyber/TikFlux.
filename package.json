{
  "name": "tikflux-desktop",
  "version": "1.0.0",
  "description": "TikFlux - TikTok LIVE Dashboard Desktop",
  "main": "main.js",
  "author": "TikFlux",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "build": "echo skip",
    "build:dir": "echo skip"
  },
  "dependencies": {
    "@tiktool/live": "^2.12.1",
    "express": "^4.22.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^35.6.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tikflux.desktop",
    "productName": "TikFlux",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/electron/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../tikoverlay.live",
        "to": "app",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../supporters_data.json",
        "to": "app/supporters_data.json"
      },
      {
        "from": "../alert_catalog.json",
        "to": "app/alert_catalog.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "TikFlux-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TikFlux",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    },
    "publish": {
      "provider": "generic",
      "url": "http://localhost:3000/releases",
      "channel": "latest"
    }
  }
}
